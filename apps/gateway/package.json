{
  "name": "@kithena/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "compose": "wgc router compose -i graph.yaml -o supergraph.json",
    "check": "wgc router compose -i graph.check.yaml -o supergraph.json",
    "typecheck": "tsc --noEmit",
