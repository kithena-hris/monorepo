{
  "name": "@reach/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build --output-dir storybook-static --stats-json",
    "typecheck": "tsc --noEmit",
    "typecheck:authoritative": "tsc6 --noEmit",
    "test:stories": "vitest run --project storybook",
    "preview": "http-server storybook-static -p 6007 --silent"
  },
  "dependencies": {
    "@reach/ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-themes": "^10.5.9",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "http-server": "^14.1.1",
    "playwright": "^1.55.0",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.1.12",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
