{
  "expo": {
    "name": "Kithena",
    "slug": "kithena",
    "scheme": "kithena",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kithena.app"
    },
    "android": {
      "package": "com.kithena.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4d53f0"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing"
    ],
    "icon": "./assets/icon.png"
  }
}
