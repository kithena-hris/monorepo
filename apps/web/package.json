{
  "name": "@kithena/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-renderer.mjs && next dev --turbopack -p 3000",
    "build": "node scripts/build-renderer.mjs && next build",
    "typecheck": "tsc --noEmit",
    "typecheck:authoritative": "tsc6 --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:acceptance": "vitest run --config vitest.acceptance.ts",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check",
    "i18n:translate": "node scripts/i18n-translate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1148.0",
    "@hookform/resolvers": "^5.9.1",
    "@kithena/contracts": "workspace:*",
    "@kithena/web-documents": "workspace:*",
    "@module-federation/runtime": "2.9.2",
    "@reach/ui": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/oidc-aws-credentials-provider": "^3.3.11",
    "@vercel/speed-insights": "^2.0.0",
    "i18next": "^26.4.6",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.18",
    "tesseract.js": "7.0.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kithena/testing": "workspace:*",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "kafkajs": "^2.2.4",
    "playwright": "^1.64.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.1.12",
    "vitest": "^5.0.3"
  }
}
