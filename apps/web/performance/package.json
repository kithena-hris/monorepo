{
  "name": "@kithena/web-performance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && vite preview --port 3007 --strictPort",
    "build": "vite build && vite build -c vite.ssr.config.ts",
    "preview": "vite preview --port 3007 --strictPort",
    "typecheck": "tsc --noEmit",
    "typecheck:authoritative": "tsc6 --noEmit",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project phone --project desk",
    "sign": "node scripts/sign-ssr.mjs"
  },
  "dependencies": {
    "@reach/ui": "workspace:*",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.4",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.12",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
