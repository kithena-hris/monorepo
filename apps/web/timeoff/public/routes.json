  "actions": [
    {
      "path": "/time-off/request",
      "label": "Request time off",
      "icon": "add",
      "for": ["member"],
      "owns": ["/time-off/request/describe"],
      "on": [
        "/time-off/overview",
        "/time-off/requests",
        "/time-off/calendar/month",
        "/time-off/calendar/timeline",
        "/time-off/calendar/year"
      ]
    },
    {
      "path": "/time-off/approvals/delegation",
      "label": "Delegate approvals",
      "icon": "transfer",
      "menu": true,
      "for": ["manager", "hr"],
      "on": [
        "/time-off/approvals/waiting",
        "/time-off/approvals/coming-up",
        "/time-off/approvals/decided"
      ]
    },
    {
      "path": "/time-off/approvals/adjustments",
      "label": "Adjust a balance",
      "icon": "adjust",
      "menu": true,
      "for": ["manager", "hr"],
      "on": [
        "/time-off/approvals/waiting",
        "/time-off/approvals/coming-up",
        "/time-off/approvals/decided"
      ]
    },
    {
      "path": "/time-off/parental/cases",
      "label": "Parental leave cases",
      "icon": "parental",
      "menu": true,
      "for": ["hr"],
      "owns": ["/time-off/parental/cases/:id"],
      "on": [
        "/time-off/approvals/waiting",
        "/time-off/approvals/coming-up",
        "/time-off/approvals/decided"
      ]
    },
    {
      "path": "/time-off/attendance/requests",
      "label": "Overtime and corrections",
      "icon": "history",
      "menu": true,
      "on": [
        "/time-off/attendance/now",
        "/time-off/attendance/timesheet",
        "/time-off/attendance/exceptions"
      ]
    },
    {
      "path": "/time-off/attendance/kiosk-code",
      "label": "Kiosk code",
      "icon": "scanCode",
      "menu": true,
      "for": ["member"],
      "on": [
        "/time-off/attendance/now",
        "/time-off/attendance/timesheet",
        "/time-off/attendance/exceptions"
      ]
    },
    {
      "path": "/time-off/attendance/pay-period",
      "label": "Close the pay period",
      "icon": "locked",
      "menu": true,
      "for": ["hr"],
      "on": [
        "/time-off/attendance/now",
        "/time-off/attendance/timesheet",
        "/time-off/attendance/exceptions"
      ]
    }
  ],
  "sections": [
    {
      "path": "/time-off/overview",
      "label": "Overview",
      "group": "Time off",
      "icon": "overview",
      "description": "Your balances, what is coming up, and who is away",
      "summary": "Balances and what is coming up",
      "owns": [
        "/time-off/requests",
        "/time-off/requests/:id",
        "/time-off/balances/:type",
        "/time-off/holidays/:year",
        "/time-off/parental/:step"
      ]
    },
    {
      "path": "/time-off/approvals/waiting",
      "label": "Approvals",
      "group": "Time off",
      "icon": "approve",
      "for": ["manager", "hr"],
      "description": "Time off waiting for your decision, coming up and decided",
      "summary": "Decisions on other people's time off",
      "tabs": [
        {
          "path": "/time-off/approvals/waiting",
          "label": "Pending",
          "owns": ["/time-off/approvals/waiting/:id", "/time-off/approvals/waiting/:id/suggest"]
        },
        {
          "path": "/time-off/approvals/coming-up",
          "label": "Upcoming"
        },
        {
          "path": "/time-off/approvals/decided",
          "label": "History"
        }
      ]
    },
    {
      "path": "/time-off/calendar/month",
      "label": "Calendar",
      "group": "Time off",
      "icon": "calendar",
      "description": "Who is away and when, by month, as a timeline or across the year",
      "summary": "Who is away, and when",
      "tabs": [
        {
          "path": "/time-off/calendar/month",
          "label": "Month"
        },
        {
          "path": "/time-off/calendar/timeline",
          "label": "Timeline"
        },
        {
          "path": "/time-off/calendar/year",
          "label": "Year"
        }
      ]
    },
    {
      "path": "/time-off/attendance/now",
      "label": "Attendance",
      "group": "Time off",
      "icon": "scheduled",
      "description": "Clocked hours, breaks and overtime",
      "summary": "Timesheets and who is in",
      "tabs": [
        {
          "path": "/time-off/attendance/now",
          "label": "Live",
          "for": ["manager", "hr"]
        },
        {
          "path": "/time-off/attendance/timesheet",
          "label": "Timesheet"
        },
        {
          "path": "/time-off/attendance/exceptions",
          "label": "Exceptions",
          "for": ["hr"]
        }
      ]
    },
    {
      "path": "/time-off/insights",
      "label": "Insights",
      "group": "Time off",
      "icon": "analytics",
      "for": ["manager", "hr"],
      "description": "What changed, time taken, attendance and balances across your people",
      "summary": "Trends across the company"
    }
  ],
  "slots": {
    "topBar": "TopBarClock"
  },
  "settings": [
    {
      "path": "/settings/time-off/leave-types",
      "label": "Leave types",
      "for": ["hr", "admin"],
      "owns": ["/settings/time-off/leave-types/:id", "/settings/time-off/leave-types/new/describe"],
      "description": "The kinds of time off people can request, and how each one is paid and approved.",
      "icon": "leave"
    },
    {
      "path": "/settings/time-off/holidays",
      "label": "Holidays",
      "for": ["hr", "admin"],
      "owns": ["/settings/time-off/holidays/:year"],
      "description": "The public holidays each location keeps, year by year.",
      "icon": "calendar"
    },
    {
      "path": "/settings/time-off/negative-balance",
      "label": "Negative balance",
      "for": ["hr", "admin"],
      "description": "What happens when someone books more than they have earned.",
      "icon": "adjust"
    },
    {
      "path": "/settings/time-off/attendance",
      "label": "Attendance",
      "for": ["hr", "admin"],
      "description": "Schedules, breaks, overtime and how clocking in works.",
      "icon": "scheduled"
    },
    {
      "path": "/settings/time-off/approvals",
      "label": "Approvals",
      "for": ["hr", "admin"],
      "description": "Who approves what, cover minimums and when a request escalates.",
      "icon": "approve"
    },
    {
      "path": "/settings/time-off/integrations",
      "label": "Integrations",
      "for": ["admin"],
      "description": "Calendars, chat apps and badge readers.",
      "icon": "link"
    }
  ]
}
