  "actions": [
    {
      "path": "/people/new",
      "label": "Add person",
      "for": ["hr"],
      "on": ["/people/directory/list", "/people/directory/cards", "/people/directory/org-chart"],
      "icon": "hire"
    }
  ],
  "sections": [
    {
      "path": "/people/directory/list",
      "label": "Directory",
      "group": "People",
      "icon": "people",
      "description": "Everyone, as a list, cards or an org chart",
      "summary": "List, cards or org chart",
      "owns": [
        "/people/directory/cards",
        "/people/directory/org-chart",
        "/people/:id",
        "/people/:id/history",
        "/people/bulk-edit"
      ]
    },
    {
      "path": "/people/review/waiting",
      "label": "Review",
      "group": "People",
      "icon": "approve",
      "description": "Every decision and missing detail, in one queue",
      "summary": "Every decision, in one queue",
      "tabs": [
        {
          "path": "/people/review/waiting",
          "label": "Waiting",
          "labelFor": {
            "hr": "Waiting for me",
            "finance": "Your requests"
          }
        },
        {
          "path": "/people/review/flagged",
          "label": "Flagged",
          "for": ["hr"]
        },
        {
          "path": "/people/review/asked",
          "label": "I asked",
          "for": ["hr"]
        },
        {
          "path": "/people/review/decided",
          "label": "Decided"
        }
      ]
    },
    {
      "path": "/people/import-export",
      "label": "Import & export",
      "group": "People",
      "icon": "transfer",
      "description": "Bring people in, take data out",
      "summary": "Move data in and out",
      "owns": ["/people/import", "/people/export"]
    },
    {
      "path": "/people/insights/what-changed",
      "label": "Insights",
      "group": "People",
      "for": ["hr"],
      "icon": "analytics",
      "description": "Summary, charts and scheduled reports",
      "summary": "Analytics and reports",
      "owns": ["/people/reports", "/people/reports/:id"],
      "tabs": [
        {
          "path": "/people/insights/what-changed",
          "label": "What changed"
        },
        {
          "path": "/people/insights/headcount",
          "label": "Headcount"
        },
        {
          "path": "/people/insights/turnover",
          "label": "Turnover"
        },
        {
          "path": "/people/insights/data-quality",
          "label": "Data quality",
          "short": "Quality"
        },
        {
          "path": "/people/insights/pay",
          "label": "Pay & diversity",
          "short": "Pay"
        }
      ]
    }
  ],
  "settings": [
    {
      "path": "/settings/people/fields",
      "label": "Employee fields",
      "for": ["admin"],
      "owns": ["/people/setup"],
      "description": "The details kept on each person, who sees them and when they’re asked.",
      "icon": "document"
    },
    {
      "path": "/settings/people/organisation",
      "label": "Organisation",
      "description": "Legal entities, locations, numbering, time zone and retention.",
      "icon": "organisation"
    },
    {
      "path": "/settings/people/roles",
      "label": "Roles",
      "for": ["hr", "admin"],
      "description": "Who has HR, administrator and finance access.",
      "icon": "permission"
    },
    {
      "path": "/settings/people/integrations",
      "label": "Integrations",
      "for": ["admin"],
      "owns": ["/settings/people/integrations/:id"],
      "description": "Slack, webhooks and identity provider sync.",
      "icon": "link"
    },
    {
      "path": "/settings/people/reminders",
      "label": "Completeness and reminders",
      "for": ["hr", "admin"],
      "description": "When people are reminded about missing details, and how small a group reports describe.",
      "icon": "notifications"
    },
    {
      "path": "/settings/people/country-packs",
      "label": "Country packs",
      "for": ["admin"],
      "description": "The identifiers, fields and rules each country needs.",
      "icon": "location"
    },
    {
      "path": "/settings/activity?area=fields,organisation,roles,integrations",
      "label": "Activity log",
      "for": ["hr", "admin"],
      "description": "Every settings change, who made it and when, in the company’s activity log.",
      "icon": "history"
    }
  ],
  "slots": {
    "home": "PeopleHome"
  }
}
