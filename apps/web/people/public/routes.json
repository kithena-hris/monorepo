  "actions": [
    {
      "path": "/people/new",
      "label": "Add employee",
      "for": [
        "hr"
      ],
      "icon": "hire"
    }
  ],
  "sections": [
    {
      "path": "/people",
      "label": "Overview",
      "group": "Workspace",
      "icon": "home",
      "description": "Your profile summary, pending tasks and reporting line."
    },
    {
      "path": "/people/directory",
      "label": "Directory",
      "group": "Workspace",
      "owns": [
        "/people/:id",
        "/people/:id/history",
        "/people/bulk-edit"
      ],
      "icon": "people",
      "description": "Search, filter and view every employee record."
    },
    {
      "path": "/people/me",
      "label": "My profile",
      "group": "Workspace",
      "owns": [
        "/people/me/history",
        "/people/onboarding"
      ],
      "icon": "person",
      "description": "Your personal and employment details."
    },
    {
      "path": "/people/approvals",
      "label": "Approvals",
      "group": "Workspace",
      "icon": "approve",
      "description": "Changes awaiting review and decision."
    },
    {
      "path": "/people/completeness",
      "label": "Data completeness",
      "group": "Records",
      "for": [
        "hr"
      ],
      "icon": "missing",
      "description": "Employee records with required details outstanding."
    },
    {
      "path": "/people/identifier-reviews",
      "label": "ID verification",
      "group": "Records",
      "for": [
        "hr"
      ],
      "icon": "review",
      "description": "National identifiers flagged for HR review."
    },
    {
      "path": "/people/duplicates",
      "label": "Duplicate records",
      "group": "Records",
      "for": [
        "hr"
      ],
      "icon": "merge",
      "description": "Potential duplicates to merge or dismiss."
    },
    {
      "path": "/people/import",
      "label": "Import",
      "group": "Records",
      "for": [
        "hr"
      ],
      "icon": "upload",
      "description": "Create or update employees in bulk from a spreadsheet."
    },
    {
      "path": "/people/export",
      "label": "Export",
      "group": "Records",
      "icon": "download",
      "description": "Download employee data with a recorded purpose."
    },
    {
      "path": "/people/full-values",
      "label": "Sensitive data access",
      "group": "Records",
      "for": [
        "finance",
        "hr"
      ],
      "icon": "sensitive",
      "description": "Request and audit access to unmasked values."
    },
    {
      "path": "/people/analytics",
      "label": "Workforce analytics",
      "group": "Insights",
      "for": [
        "hr"
      ],
      "icon": "analytics",
      "description": "Headcount, turnover and compensation trends."
    },
    {
      "path": "/people/reports",
      "label": "Report schedules",
      "group": "Insights",
      "for": [
        "hr",
        "admin"
      ],
      "owns": [
        "/people/reports/:id"
      ],
      "icon": "report",
      "description": "Recurring reports delivered to each recipient."
    }
  ],
  "settings": [
    {
      "path": "/settings/people/fields",
      "label": "Employee fields",
      "for": [
        "admin"
      ],
      "owns": [
        "/people/setup"
      ],
      "description": "The details People keeps on each person: what they are, who sees them, and when they are asked.",
      "icon": "document"
    },
    {
      "path": "/settings/people/organisation",
      "label": "Organisation",
      "description": "Legal entities, work locations, employee numbering, the default time zone and retention.",
      "icon": "organisation"
    },
    {
      "path": "/settings/people/roles",
      "label": "Roles",
      "for": [
        "hr",
        "admin"
      ],
      "description": "Who is an HR member, a People administrator or in finance here.",
      "icon": "permission"
    },
    {
      "path": "/settings/people/integrations",
      "label": "Integrations",
      "for": [
        "admin"
      ],
      "owns": [
        "/settings/people/integrations/:id"
      ],
      "description": "Third-party tools: webhooks to payroll, benefits or IT, and provisioning from Okta or Entra. Kithena modules are connected already.",
      "icon": "link"
    },
    {
      "path": "/settings/people/activity",
      "label": "Activity",
      "for": [
        "hr",
        "admin"
      ],
      "description": "Every change to these settings: who made it, when, and what.",
      "icon": "history"
    }
  ]
}
