{
  "routes": [
    {
      "path": "/people",
      "component": "PeopleHome"
    },
    {
      "path": "/people/directory",
      "component": "Directory"
    },
    {
      "path": "/people/new",
      "component": "AddPerson"
    },
    {
      "path": "/people/setup",
      "component": "PeopleSetup"
    },
    {
      "path": "/people/onboarding",
      "component": "Onboarding"
    },
    {
      "path": "/people/me",
      "component": "Profile"
    },
    {
      "path": "/people/me/history",
      "component": "PersonHistory"
    },
    {
      "path": "/people/completeness",
      "component": "CompletenessGrid"
    },
    {
      "path": "/people/bulk-edit",
      "component": "BulkEdit"
    },
    {
      "path": "/settings/people/fields",
      "component": "FieldRegistry"
    },
    {
      "path": "/settings/people/integrations",
      "component": "Integrations"
    },
    {
      "path": "/settings/people/integrations/:id",
      "component": "WebhookLog"
    },
    {
      "path": "/settings/people/roles",
      "component": "RoleSettings"
    },
    {
      "path": "/settings/people/organisation",
      "component": "Organisation"
    },
    {
      "path": "/people/import",
      "component": "ImportFlow"
    },
    {
      "path": "/people/export",
      "component": "ExportBuilder"
    },
    {
      "path": "/people/full-values",
      "component": "FullValues"
    },
    {
      "path": "/people/identifier-reviews",
      "component": "IdentifierReviews"
    },
    {
      "path": "/people/approvals",
      "component": "Approvals"
    },
    {
      "path": "/people/duplicates",
      "component": "Duplicates"
    },
    {
      "path": "/people/analytics",
      "component": "Analytics"
    },
    {
      "path": "/people/reports",
      "component": "ReportSchedules"
    },
    {
      "path": "/people/reports/:id",
      "component": "ReportRuns"
    },
    {
      "path": "/people/:id",
      "component": "Profile"
    },
    {
      "path": "/people/:id/history",
      "component": "PersonHistory"
    },
    {
      "path": "/settings/people",
      "component": "PeopleSettings"
    }
  ],
  "actions": [
    {
      "path": "/people/new",
      "label": "Add employee",
      "for": ["hr"],
      "icon": "hire"
    }
  ],
  "sections": [
    {
      "path": "/people",
      "label": "Overview",
      "group": "Everyday",
      "icon": "home",
      "description": "Your details, what needs you, and who you report to."
    },
    {
      "path": "/people/directory",
      "label": "Directory",
      "group": "Everyday",
      "owns": ["/people/:id", "/people/:id/history", "/people/bulk-edit"],
      "icon": "people",
      "description": "Everybody here. Search, filter and open a profile."
    },
    {
      "path": "/people/me",
      "label": "My profile",
      "group": "Everyday",
      "owns": ["/people/me/history", "/people/onboarding"],
      "icon": "person",
      "description": "Your own record: details, photo and history."
    },
    {
      "path": "/people/approvals",
      "label": "Approvals",
      "group": "Everyday",
      "icon": "approve",
      "description": "Changes waiting for somebody to decide."
    },
    {
      "path": "/people/completeness",
      "label": "Missing information",
      "group": "Records",
      "for": ["hr"],
      "icon": "missing",
      "description": "Records with required details still to fill in."
    },
    {
      "path": "/people/identifier-reviews",
      "label": "Identifiers to review",
      "group": "Records",
      "for": ["hr"],
      "icon": "review",
      "description": "National IDs the checks doubted, waiting for HR."
    },
    {
      "path": "/people/duplicates",
      "label": "Possible duplicates",
      "group": "Records",
      "for": ["hr"],
      "icon": "merge",
      "description": "Records that may be the same person, to merge or dismiss."
    },
    {
      "path": "/people/import",
      "label": "Import",
      "group": "Records",
      "for": ["hr"],
      "icon": "upload",
      "description": "Add or update many people from a spreadsheet."
    },
    {
      "path": "/people/export",
      "label": "Export",
      "group": "Records",
      "icon": "download",
      "description": "People and their details as a file, with a reason."
    },
    {
      "path": "/people/full-values",
      "label": "Full values",
      "group": "Records",
      "for": ["finance", "hr"],
      "icon": "sensitive",
      "description": "Unmasked values, asked for with a reason and audited."
    },
    {
      "path": "/people/analytics",
      "label": "Analytics",
      "group": "Reporting",
      "for": ["hr"],
      "icon": "analytics",
      "description": "Headcount, movement and pay, as charts."
    },
    {
      "path": "/people/reports",
      "label": "Scheduled reports",
      "group": "Reporting",
      "for": ["hr", "admin"],
      "owns": ["/people/reports/:id"],
      "icon": "report",
      "description": "Reports built for each recipient and emailed on a schedule."
    }
  ],
  "settings": [
    {
      "path": "/settings/people/fields",
      "label": "Employee fields",
      "for": ["admin"],
      "owns": ["/people/setup"],
      "description": "The details People keeps on each person: what they are, who sees them, and when they are asked.",
      "icon": "document"
    },
    {
      "path": "/settings/people/organisation",
      "label": "Organisation",
      "description": "Legal entities, work locations, employee numbering, the default time zone and retention.",
      "icon": "organisation"
    },
    {
      "path": "/settings/people/roles",
      "label": "Roles",
      "for": ["hr", "admin"],
      "description": "Who is an HR member, a People administrator or in finance here.",
      "icon": "permission"
    },
    {
      "path": "/settings/people/integrations",
      "label": "Integrations",
      "for": ["admin"],
      "owns": ["/settings/people/integrations/:id"],
      "description": "Webhooks that tell other systems about changes, and provisioning from an identity provider.",
      "icon": "link"
    }
  ]
}
