  "settings": [
    {
      "path": "/settings/people/fields",
      "label": "Employee fields",
      "for": ["admin"],
      "owns": ["/people/setup"],
      "description": "The details kept on each person, who sees them and when they’re asked.",
      "icon": "document"
    },
    {
      "path": "/settings/people/organisation",
      "label": "Organisation",
      "description": "Legal entities, locations, numbering, time zone and retention.",
      "icon": "organisation"
    },
    {
      "path": "/settings/people/roles",
      "label": "Roles",
      "for": ["hr", "admin"],
      "description": "Who has HR, administrator and finance access.",
      "icon": "permission"
    },
    {
      "path": "/settings/people/integrations",
      "label": "Integrations",
      "for": ["admin"],
      "owns": ["/settings/people/integrations/:id"],
      "description": "Slack, webhooks and identity provider sync.",
      "icon": "link"
    },
    {
      "path": "/settings/people/reminders",
      "label": "Completeness and reminders",
      "for": ["hr", "admin"],
      "description": "When people are reminded about missing details, and how small a group reports describe.",
      "icon": "notifications"
    },
    {
      "path": "/settings/people/country-packs",
      "label": "Country packs",
      "for": ["admin"],
      "description": "The identifiers, fields and rules each country needs.",
      "icon": "location"
    },
    {
      "path": "/settings/people/activity",
      "label": "Activity log",
      "for": ["hr", "admin"],
      "description": "Every settings change, who made it and when.",
      "icon": "history"
    }
