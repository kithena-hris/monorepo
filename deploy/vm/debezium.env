# The outbox relay: Debezium Server tailing one database's outbox and
# publishing each row to Redpanda, unchanged.
#
# Environment rather than an `application.properties` mounted into the
# container: Compose reads this file on the host, as root, so nothing depends
# on what the image's own user (uid 185) may read in the VM's config directory,
# which is root's alone. `DEBEZIUM_SINK_TYPE` is `debezium.sink.type`, and so
# on: upper case, dots as underscores. Values are literal (`$1`, `\.`).
#
# One instance per database, because Debezium Server runs one source:
# identity's outbox is on Neon and People's is on the VM. Everything that
# differs between them — where the database is, who connects, which table, the
# slot's name — is set on each service in `compose.yaml` (and `relay.env`);
# everything here is the same for both. The publication and the role are made
# by the `*_outbox_relay.sql` migrations.

DEBEZIUM_SINK_TYPE=kafka
DEBEZIUM_SINK_KAFKA_PRODUCER_BOOTSTRAP_SERVERS=redpanda:9092
DEBEZIUM_SINK_KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
DEBEZIUM_SINK_KAFKA_PRODUCER_VALUE_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
# Every row is published exactly once to the broker or the relay stops: no
# duplicates from a retried send reordering a tenant's events.
DEBEZIUM_SINK_KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
DEBEZIUM_SINK_KAFKA_PRODUCER_ACKS=all

DEBEZIUM_SOURCE_CONNECTOR_CLASS=io.debezium.connector.postgresql.PostgresConnector
DEBEZIUM_SOURCE_PLUGIN_NAME=pgoutput
DEBEZIUM_SOURCE_PUBLICATION_NAME=kithena_outbox
# The migration made it; the relay's role could not, and should not.
DEBEZIUM_SOURCE_PUBLICATION_AUTOCREATE_MODE=disabled
DEBEZIUM_SOURCE_DATABASE_PORT=5432
DEBEZIUM_SOURCE_DATABASE_USER=svc_debezium
DEBEZIUM_SOURCE_TOPIC_PREFIX=kithena-relay
# Where the relay has got to, on the container's volume. The slot on the
# database holds the rest: WAL is kept until the relay confirms it.
DEBEZIUM_SOURCE_OFFSET_STORAGE_FILE_FILENAME=/debezium/data/offsets.dat
DEBEZIUM_SOURCE_OFFSET_FLUSH_INTERVAL_MS=1000
# The first start publishes every outbox row there already is, which is how the
# events written before the relay existed reach their consumers; after that,
# only new rows. `when_needed` takes the snapshot again if the slot has gone
# (a database restored, a slot dropped), rather than silently starting from
# now and losing whatever was written in between. Consumers are idempotent by
# event id, so a replay changes nothing twice.
DEBEZIUM_SOURCE_SNAPSHOT_MODE=when_needed
# Advances the slot while nothing is written, so an idle outbox does not hold
# back the WAL every other table writes.
DEBEZIUM_SOURCE_HEARTBEAT_INTERVAL_MS=60000

# Debezium's outbox router: the row's `envelope` is the message, its `topic`
# (generated from the event's name and version, exactly as the contract names
# it) is where it goes, and `partition_key` (tenant:aggregate) keeps each
# aggregate's events in order.
DEBEZIUM_TRANSFORMS=outbox
DEBEZIUM_TRANSFORMS_OUTBOX_TYPE=io.debezium.transforms.outbox.EventRouter
DEBEZIUM_TRANSFORMS_OUTBOX_TABLE_FIELD_EVENT_ID=event_id
DEBEZIUM_TRANSFORMS_OUTBOX_TABLE_FIELD_EVENT_KEY=partition_key
DEBEZIUM_TRANSFORMS_OUTBOX_TABLE_FIELD_EVENT_PAYLOAD=envelope
DEBEZIUM_TRANSFORMS_OUTBOX_ROUTE_BY_FIELD=topic
# The router's default regex captures the whole value; `$1` rather than its
# `${routedByValue}`, which Quarkus would take for a config expression.
DEBEZIUM_TRANSFORMS_OUTBOX_ROUTE_TOPIC_REPLACEMENT=$1
DEBEZIUM_TRANSFORMS_OUTBOX_TABLE_EXPAND_JSON_PAYLOAD=false
# Outbox rows only: the heartbeat's own record has no `topic` to route by and
# goes to its topic as it is.
DEBEZIUM_PREDICATES=outboxes
DEBEZIUM_PREDICATES_OUTBOXES_TYPE=org.apache.kafka.connect.transforms.predicates.TopicNameMatches
DEBEZIUM_PREDICATES_OUTBOXES_PATTERN=kithena-relay\..+\.outbox
DEBEZIUM_TRANSFORMS_OUTBOX_PREDICATE=outboxes

DEBEZIUM_FORMAT_KEY=simplestring
DEBEZIUM_FORMAT_VALUE=simplestring

QUARKUS_LOG_LEVEL=INFO
