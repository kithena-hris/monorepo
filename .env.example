NODE_ENV=development

DATABASE_URL=postgres://kithena:kithena@localhost:5432/kithena
REDPANDA_BROKERS=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081
# People's authorization (PEO-092). Set, and People reads relations from
# OpenFGA and writes its tuples from its own events; unset, it derives them from
# `people.person` and the forwarded roles, which is what `just standalone
# people` runs. The store is found by name ("people"), or created, when no id
# is given.
OPENFGA_URL=http://localhost:8080
OPENFGA_STORE_ID=
TEMPORAL_ADDRESS=localhost:7233
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-only-key

# The identity service, on 4100. Modules take 40xx and the Cosmo Router already
# holds 4000, which is where this pointed before and could never have worked.
AUTH_ISSUER=http://localhost:4100
AUTH_JWKS_URL=http://localhost:4100/.well-known/jwks.json
# The router's audience: identity signs access tokens for it and the router
# refuses any other (PEO-113). The same value on both.
AUTH_TOKEN_AUDIENCE=kithena-router
# Keys identity publishes in its JWKS and never signs with: the next one
# before a rotation, the previous one until its tokens expire. A JSON array of
# JWKs; only public halves are served. See docs/authentication.md, "Sessions".
AUTH_VERIFICATION_KEYS=

# The modules a company has when the back office has recorded none for it, as
# a JSON array (PEO-114). A default only: a company's own list, set in the
# company wizard or on its page, is stored on `platform.tenant` and wins.
# Identity reads it; the Cosmo Router still forwards it for such a company.
KITHENA_ENTITLEMENTS=["module.people"]

# Identity connects as its own role, not as the database owner. The owner
# bypasses row-level security by virtue of owning the tables, so a service that
# must be constrained by a policy cannot be the owner — see
# docs/environments.md, where the difference is measured rather than assumed.
# Migrations still run as the owner, because they are supposed to see
# everything.
IDENTITY_DATABASE_URL=postgres://svc_identity:kithena@localhost:5432/kithena

# The token signing key, as a private JWK. Absent locally, where identity
# generates a throwaway one and says so; required in production, where a key
# that changes on every restart looks like users being logged out at random
# rather than like a missing setting.
AUTH_SIGNING_KEY=

# The WebAuthn relying party. Every credential is bound to this, and it is the
# suffix every acceptable ceremony origin ends in — `app.kithena.com` in
# production, so one passkey works at every tenant subdomain. Deliberately not
# `kithena.com`, which would make credentials assertable from the public Reach
# sites.
WEBAUTHN_RP_ID=app.localhost

# Where a company's uploaded logo and cover image may be served from, comma
# separated. A leading dot is a suffix, so this one entry covers every Blob
# bucket. Unset, identity assumes exactly this — set it only when the images
# move somewhere else. See docs/self-hosting.md.
IDENTITY_IMAGE_HOSTS=.public.blob.vercel-storage.com
AUTH_ORIGIN=http://auth.app.localhost:3000

# The back-office relying party, which is deliberately not the one above. A
# credential is bound to one hostname: `app.localhost` covers every tenant and
# the auth origin beneath it, and the back-office sits on `localhost:3001`,
# which is not under that suffix. Two products, two passkeys.
ADMIN_RP_ID=localhost
ADMIN_ORIGIN=http://localhost:3001

# The messaging service, on 4101. Platform services take 41xx; identity holds
# 4100. Identity calls it with INTERNAL_API_TOKEN to send an invitation, and
# leaving it unset is a supported deployment rather than a broken one — the
# enrolment link still comes back in the response, and docs/authentication.md
# prefers that link handed over in person anyway.
MESSAGING_URL=http://localhost:4101

# The secret identity presents to messaging, and messaging checks.
#
# Its own rather than INTERNAL_API_TOKEN, which every front end presents to
# identity — reusing that one would mean a leak from any of them also granting
# the ability to send Kithena-branded mail to any address. One secret per pair
# of services is the least privilege version.
#
# Falls back to INTERNAL_API_TOKEN on both sides when unset, so a deployment
# that has not split them yet keeps working.
MESSAGING_API_TOKEN=dev-only-key

# The secret People presents to identity to list a tenant's accounts
# (reconciliation, PRD §8.2), for the same reason: that listing is every work
# email and name in a company. Falls back to INTERNAL_API_TOKEN on both sides
# when unset. People reconciles only when IDENTITY_URL is set as well.
PEOPLE_IDENTITY_TOKEN=dev-only-key
IDENTITY_URL=http://localhost:4100

# People's master keys, `id:base64,id:base64`, 32 bytes each; the first is
# current. They wrap `people.person_secret` and derive the per-tenant keys
# unique claims are hashed with (PEO-082). Generate one with
# `openssl rand -base64 32`. Never commit a real one.
#
# Rotating is four steps, in this order, each deployed everywhere before the
# next:
#   1. add the new key AFTER the current one   (old,new) — every replica can
#      now look under it, before any writes with it
#   2. swap them                               (new,old) — writes move to it;
#      two hourly jobs move what is already written: one re-keys unique
#      claims, the other re-wraps every encrypted value's data key under the
#      new key (PEO-105; the values themselves are never decrypted or logged)
#   3. wait until no claim and no secret has the old key id
#      (`SELECT count(*) FROM people.person_secret WHERE key_id = '<old>'` is
#      0, and the same on people.attribute_unique), and HR's grid shows no
#      unique_conflict row
#   4. drop the old key                        (new)
# Skipping step 1 is refused: the claim job logs an error and does not run
# while claims sit under a key the ring lacks and none under the current one.
# Dropping a key too early is refused too: the secret job logs an error and
# stops while any secret is under a key the ring lacks — put it back after
# the current one and restart.
# PEOPLE_SECRET_KEYS=k1:<base64>

# Resend. Absent locally, where messaging writes invitations to the log and says
# so — the same arrangement as AUTH_SIGNING_KEY above, and the only way to walk
# the enrolment flow repeatedly without spending a real send on a real mailbox.
# Required in production, where the service refuses to start without it.
RESEND_API_KEY=

# Who invitations come from. `Name <address@domain>`, or a bare address.
#
# On `send.kithena.com` rather than the apex, and that separation is the point:
# transactional sending builds its own reputation, so a bad month for one does
# not follow the other. It also means a compromise of this key cannot send as
# anybody at `kithena.com`.
#
# The domain must be verified in Resend and must match *exactly* — a `from` on
# `kithena.com` against a key verified for `send.kithena.com` is a 403 at send
# time, which nothing local can catch. A mailbox being active is not the same as
# its domain being a verified sender.
#
# This is the setting that moves, and it moves alone: a dedicated address later
# is one variable in one place and no code change. It is parsed at boot rather
# than at send, so a typo here is a service that will not start rather than a
# new hire who never receives their invitation.
#
# Click tracking must stay OFF for this domain. It rewrites every link through
# Resend's own host, which would both hand the single-use enrolment token to a
# third party and change the origin the enrolment ceremony checks. Open tracking
# too: a pixel in a transactional message to an employee is surveillance we have
# no reason to do and would then have to declare.
# Quoted: the angle brackets are shell redirection unquoted, so `. ./.env`
# fails with a parse error on this line and every variable after it is unset.
# A mailbox on this machine. `docker-compose.yml` runs Mailpit on 1025 and its
# inbox is at http://localhost:8025 — set this and every invitation, recovery
# link and notification arrives there rendered, instead of as text in a log.
#
# Development only. `composition.ts` refuses it wherever it refuses the log
# transport, so production cannot be pointed at a relay by setting one variable.
SMTP_URL=smtp://localhost:1025

RESEND_FROM='Kithena <invitations@send.kithena.com>'

# Where a reply goes, and deliberately not on the sending subdomain: this is the
# real mailbox somebody reads. People answer these — "is this genuine?" is the
# most likely reply an invitation gets — and a reply bouncing off a no-reply
# address is a new hire who could not ask.
RESEND_REPLY_TO=info@kithena.com

# Where messaging records what it sent. Outcomes only — never a body and never a
# link, because the enrolment token is stored as a hash precisely so it cannot
# be read back out of anything. Absent locally, where the outcome lives in the
# response and the log.
#
# `svc_messaging`, not the owner: an owner bypasses row-level security on its
# own tables whatever the policy says, and `messaging.delivery` is scoped by one.
MESSAGING_DATABASE_URL=postgres://svc_messaging:kithena@localhost:5432/kithena

# Resend's webhook signing secret, from the dashboard. Without it the webhook
# endpoint refuses every request rather than trusting it — an unverified webhook
# is an open API for marking any message bounced or complained, and the second
# is how somebody gets a sending domain suppressed.
#
# It is also what turns a bounce into something HR can see. Sending records
# `accepted`; only the webhook knows whether a mailbox ever took it.
RESEND_WEBHOOK_SECRET=

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kithena-dev
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

AI_ENABLED=false
ANTHROPIC_API_KEY=

# Which hostname suffix a tenant label sits in front of. `acme.app.kithena.com`
# in production, `acme.staging.app.kithena.com` in staging. Configured rather
# than inferred: inferring it means guessing how many labels belong to the
# environment, and guessing wrong on a hostname somebody else controls.
TENANT_HOST_SUFFIX=app.localhost
# Where the auth origin sends somebody for their company's own sign-in page.
# `{slug}` is substituted with the tenant label.
MODERN_TENANT_APP_BASE=http://{slug}.app.localhost:3000
# The same rule for People and messaging: where a notice email links, and the
# only shape of origin messaging will put in one.
TENANT_APP_BASE=http://{slug}.app.localhost:3000
# Where the People remote is deployed: its `remoteEntry.js` and `routes.json`
# sit at the root. Read per request, so moving the remote never rebuilds the
# shell. `pnpm --filter @kithena/web-people build && … preview` serves it here.
PEOPLE_REMOTE_URL=http://localhost:3002
# The remote's server build (`ssr/people.cjs`) is evaluated by the shell's
# server to put each People screen in the HTML (PEO-094). `off` trusts the
# remote's host with less and renders the screens in the browser only.
PEOPLE_REMOTE_SSR=
# Where the shell's server reaches the modules: the Cosmo Router, with an
# access token identity issues it per session (PEO-113). The shell has no
# address or token for People itself; People answers only the router.
ROUTER_URL=http://localhost:4000

# People's export files (PRD §15.1). All optional: unset, files are kept in
# memory and large exports run in-process, and the service says so at boot.
# With a bucket set, both keys are required (32 bytes, base64) — a key that
# changed on restart would leave every stored file unreadable.
# VALKEY_URL is shared with identity's session cache; People queues exports on it.
# VALKEY_URL=redis://localhost:6379
# A bucket of its own: the sweep deletes anything in it older than 24 hours.
# The endpoint and credentials are PEOPLE_EXPORT_S3_ENDPOINT, _REGION,
# _ACCESS_KEY_ID and _SECRET_ACCESS_KEY, each falling back to S3_* above
# (Oracle Object Storage in production; docs/environments.md).
PEOPLE_EXPORT_BUCKET=
PEOPLE_EXPORT_ENCRYPTION_KEY=
PEOPLE_EXPORT_SIGNING_KEY=
# Where `GET /v1/exports/files/…` is reachable from a browser.
PEOPLE_EXPORT_LINK_BASE=http://localhost:4001/v1/exports/files

# Where the browser uploads an import's file, straight from the page with a
# presigned PUT (PRD §14.2): Cloudflare R2 in production. Its own endpoint and
# credentials, PEOPLE_UPLOAD_S3_*, falling back to S3_* above. Unset: imports
# are unavailable. `just dev` creates it and sets its CORS (the origins below)
# and one-day lifecycle: `pnpm --filter @kithena/people upload-bucket`.
PEOPLE_UPLOAD_BUCKET=people-uploads
PEOPLE_UPLOAD_CORS_ORIGINS=http://*.app.localhost:3000

# The tenant registry is read through a route handler rather than a direct
# connection, because proxy code runs in a constrained runtime where a
# connection pool per invocation is the wrong shape. The registry belongs to the
# identity service, so the proxy asks it rather than asking the app it sits in
# front of.
INTERNAL_API_URL=http://localhost:4100
INTERNAL_API_TOKEN=dev-only-key

# A throwaway database Atlas computes migration diffs against. It is dropped and
# recreated on every run, so it must never be the one being migrated.
ATLAS_DEV_URL=docker://postgres/17/dev?search_path=public
