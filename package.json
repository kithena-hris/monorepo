{
  "name": "kithena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "just dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "typecheck:authoritative": "turbo run typecheck:authoritative",
    "lint": "oxlint --ignore-pattern '.claude/**' . && eslint --config tools/lint/eslint.config.js .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:contract": "turbo run test:contract",
    "test:stories": "turbo run test:stories",
    "storybook": "turbo run dev --filter @reach/storybook",
    "storybook:build": "turbo run build --filter @reach/storybook",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages platform services",
    "codegen": "turbo run codegen",
    "db:migrate": "atlas migrate apply --env local --allow-dirty",
    "db:seed": "pnpm --filter @kithena/identity seed",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "a11y:contrast": "node tools/a11y/contrast-sweep.mjs",
    "a11y:contrast:build": "node tools/a11y/contrast-against-build.mjs",
    "storybook:theme-drift": "node tools/storybook/manager-theme-drift.mjs",
    "docs:catalogue-drift": "node tools/storybook/catalogue-drift.mjs",
    "hooks:install": "sh tools/scripts/install-gitleaks.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "docs:brand-leak": "node tools/storybook/brand-leak.mjs",
    "email:theme-drift": "node tools/email/theme-drift.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.13.6",
    "@typescript/typescript6": "npm:@typescript/typescript6@^6.0.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "syncpack": "^15.3.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "6 || 7"
      }
    },
    "patchedDependencies": {
      "@pothos/plugin-federation@4.5.3": "patches/@pothos__plugin-federation@4.5.3.patch"
    },
    "overrides": {
      "protobufjs@8": ">=8.0.2",
      "uuid@8": ">=11.1.1",
      "uuid@9": ">=11.1.1",
      "uuid@10": ">=11.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "react-router": ">=7.18.2 <8",
      "serialize-javascript": ">=7.0.3",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "ts-deepmerge": ">=8.0.0",
      "fast-uri@<3.1.6": ">=3.1.8 <4",
      "hono@<4.13.5": ">=4.13.8 <5",
      "undici@<5.29.0": "^5.29.0",
      "undici@>=6 <6.28.0": "^6.28.0",
      "path-to-regexp@>=4 <6.3.0": "^6.3.0",
      "ajv@>=7 <8.18.0": "^8.18.0",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "tmp@<0.2.6": "^0.2.6",
      "adm-zip@<0.6.1": "^0.6.1",
      "@types/node": "^24.13.6"
    },
    "packageExtensions": {
      "@modern-js/server-utils": {
        "dependencies": {
          "typescript": "npm:@typescript/typescript6@^6.0.2"
        }
      },
      "dependency-cruiser": {
        "dependencies": {
          "typescript": "npm:@typescript/typescript6@^6.0.2"
        }
      }
    }
  }
}
