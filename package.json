{
  "name": "kithena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "just dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "typecheck:authoritative": "turbo run typecheck:authoritative",
    "lint": "oxlint --ignore-pattern '.claude/**' . && NODE_OPTIONS=--max-old-space-size=8192 eslint --config tools/lint/eslint.config.js .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:contract": "turbo run test:contract",
    "test:stories": "turbo run test:stories",
    "storybook": "turbo run dev --filter @reach/storybook",
    "storybook:build": "turbo run build --filter @reach/storybook",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages platform services",
    "codegen": "turbo run codegen",
    "db:migrate": "atlas migrate apply --env local --allow-dirty",
    "db:seed": "pnpm --filter @kithena/identity seed && pnpm --silent --filter @kithena/identity events | pnpm --filter @kithena/people seed && pnpm --silent --filter @kithena/identity events | pnpm --filter @kithena/timeoff seed",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "a11y:contrast": "node tools/a11y/contrast-sweep.mjs",
    "a11y:contrast:build": "node tools/a11y/contrast-against-build.mjs",
    "storybook:theme-drift": "node tools/storybook/manager-theme-drift.mjs",
    "docs:catalogue-drift": "node tools/storybook/catalogue-drift.mjs",
    "hooks:install": "sh tools/scripts/install-gitleaks.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "docs:brand-leak": "node tools/storybook/brand-leak.mjs",
    "email:theme-drift": "node tools/email/theme-drift.mjs",
    "reach-mobile:parity": "node tools/reach-mobile/parity.mjs",
    "reach-mobile:compare": "node tools/reach-mobile/compare.mjs",
    "reach-mobile:import-design": "node tools/reach-mobile/import-design.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.0",
    "@typescript/typescript6": "npm:@typescript/typescript6@^6.0.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "syncpack": "^15.3.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "6 || 7"
      }
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "patchedDependencies": {
      "@pothos/plugin-federation@4.5.3": "patches/@pothos__plugin-federation@4.5.3.patch"
    },
    "overrides": {
      "protobufjs@8": ">=8.0.2",
      "uuid@8": ">=11.1.1",
      "uuid@9": ">=11.1.1",
      "uuid@10": ">=11.1.1",
      "uuid@7": ">=11.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "react-router": ">=7.18.2 <8",
      "serialize-javascript": ">=7.0.3",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "ts-deepmerge": ">=8.0.0",
      "fast-uri@<3.1.6": ">=3.1.8 <4",
      "hono@<4.13.5": ">=4.13.8 <5",
      "undici@>=6 <6.28.1": "^6.28.1",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "tmp@<0.2.6": "^0.2.6",
      "adm-zip@<0.6.1": "^0.6.1",
      "@expo/metro-config>lightningcss": "1.30.1",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "source-map-js@<1.2.2": "^1.2.2",
      "shell-quote@<1.11.0": "^1.11.0",
      "sharp@>=0.35 <0.35.5": "^0.35.5",
      "axios@<1.20.0": "^1.20.0",
      "@grpc/grpc-js@>=1.14 <1.14.5": "^1.14.5",
      "@fastify/busboy@<3.2.1": "^3.2.2",
      "@types/node": "^24.19.0"
    },
    "packageExtensions": {
      "@modern-js/server-utils": {
        "dependencies": {
          "typescript": "npm:@typescript/typescript6@^6.0.2"
        }
      },
      "dependency-cruiser": {
        "dependencies": {
          "typescript": "npm:@typescript/typescript6@^6.0.2"
        }
      }
    }
  }
}
