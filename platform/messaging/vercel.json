{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo run build --filter=@kithena/messaging...",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/gateway?__path=/$1"
    }
  ],
  "functions": {
    "api/gateway.ts": {
      "maxDuration": 15
    }
  },
  "outputDirectory": "public"
}
