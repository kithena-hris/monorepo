node_modules/
dist/
# Rspack writes the client bundle here alongside `dist`.
static/
.next/
.turbo/
coverage/
*.tsbuildinfo
.env
.env.local
generated/
src/generated/
pacts/
.DS_Store

# Generated subgraph SDL is checked in deliberately (the gateway composes from
# it and `wgc subgraph check` diffs it); build output is not.
storybook-static/

# Local run output. These capture absolute paths from whichever machine
# produced them, so they are noise in a diff and leak a directory layout.
*.log

# Personal Claude Code settings. `settings.json` is shared configuration and is
# checked in; `settings.local.json` is per-developer and is not.
.claude/settings.local*.json

# Vercel CLI link state, and the OIDC token it downloads alongside it. The
# per-app .gitignore that `vercel link` writes already covers these; this is
# the same rule at the root so a new app cannot miss it.
.vercel
.env.local

# Composed locally and in CI from the subgraph SDL; never committed.
apps/gateway/supergraph.json

# Local compose tweaks. A developer with Postgres already installed needs to
# republish the container on another port, because the host's own daemon binds
# 127.0.0.1:5432 and wins the race for `localhost`. That is a property of one
# machine, not of the project.
docker-compose.override.yml
