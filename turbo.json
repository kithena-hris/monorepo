{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    // The shell's build also writes `.renderer/` (`scripts/build-renderer.mjs`),
    // which the deployment serves remotes' server HTML from. Undeclared, a
    // cache hit restored `.next/` without it and the Vercel build failed on
    // `lstat .renderer/renderer.cjs` after a change that left the shell alone.
    "@kithena/web#build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": [".next/**", "!.next/cache/**", ".renderer/**"]
    },
    "codegen": {
      // A module's codegen imports its own GraphQL schema, which imports the
      // shared kits. Those have to be built first — `^codegen` alone leaves the
      // dependency's `dist/` missing and the import fails at runtime.
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "schema/**"],
      "outputs": ["src/generated/**", "generated/**", "schemas/**"]
    },
    "typecheck": { "dependsOn": ["^build", "codegen"], "outputs": [] },
    "typecheck:authoritative": { "dependsOn": ["^build", "codegen"], "outputs": [] },
    // No `coverage/**`: nothing runs vitest with `--coverage`, so declaring it
    // made turbo warn on every package after every run about an output that was
    // never going to exist. Tests are cached on their inputs and produce no
    // artifact worth restoring.
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:stories": { "dependsOn": ["^build"], "outputs": [] },
    // Cached on the package, everything it depends on, and the migrations its
    // containers apply (the suites read `migrations/` from the root). Real
    // Postgres in a container is the same every run, so an unchanged package
    // passing again proves nothing new; a People shard's `--shard` is part of
    // the key, so each shard is cached on its own.
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/migrations/**"],
      "outputs": []
    },
    "test:contract": { "dependsOn": ["^build"], "outputs": ["pacts/**"] },
    // Uncached: the whole point is that it boots the module fresh, and a cache
    // hit would report a module still boots alone without ever trying.
    "test:standalone": { "dependsOn": ["^build"], "cache": false },
    // Contracts' codegen writes its artifacts into *another* package,
    // `packages/telemetry/src/generated/` (redaction.ts, ai-deny.ts), which turbo cannot
    // express: `outputs` are relative to the task's own package. Declaring the
    // shared `codegen` outputs here would warn about files it never produces,
    // and declaring none would let a cache hit skip the run that keeps
    // telemetry's redaction list in step with the registry. Uncached is the
    // honest answer; the walk takes a few hundred milliseconds.
    "@kithena/contracts#codegen": { "dependsOn": ["^build"], "cache": false },

    "dev": { "cache": false, "persistent": true }
  }
}
