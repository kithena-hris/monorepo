{
  "name": "@kithena/documents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:authoritative": "tsc6 --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.ts",
    "test:contract": "vitest run --config vitest.contract.ts",
    "test:standalone": "vitest run --config vitest.standalone.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/seed-local.ts",
    "codegen": "tsx ../../tools/codegen/src/subgraph.ts",
    "bucket": "tsx --env-file-if-exists=../../.env src/configure-bucket.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@kithena/auth-kit": "workspace:*",
    "@kithena/contracts": "workspace:*",
    "@kithena/db-kit": "workspace:*",
    "@kithena/domain-kit": "workspace:*",
    "@kithena/graphql-kit": "workspace:*",
    "@kithena/telemetry": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "compromise": "^14.18.0",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.24.4",
    "kafkajs": "^2.2.4",
    "pdf-lib": "1.17.1",
    "postgres": "^3.4.5",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kithena/testing": "workspace:*",
    "vitest": "^5.0.3"
  }
}
