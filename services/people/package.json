{
  "name": "@kithena/people",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:authoritative": "tsc6 --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:contract": "vitest run --config vitest.contract.ts",
    "test:integration": "vitest run --config vitest.integration.ts",
    "test:standalone": "vitest run --config vitest.standalone.ts",
    "db:migrate": "atlas migrate apply --env local",
    "codegen": "tsx ../../tools/codegen/src/subgraph.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@kithena/auth-kit": "workspace:*",
    "@kithena/contracts": "workspace:*",
    "@kithena/db-kit": "workspace:*",
    "@kithena/domain-kit": "workspace:*",
    "@kithena/graphql-kit": "workspace:*",
    "@kithena/telemetry": "workspace:*",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "graphql-yoga": "^5.24.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kithena/testing": "workspace:*",
    "@temporalio/testing": "^1.22.0",
    "fast-formula-parser": "1.0.19",
    "graphql": "^16.11.0",
    "vitest": "^4.1.11"
  }
}
